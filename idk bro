String swap
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.next();
        int m = sc.nextInt();
        int[] a = new int[m];
        for (int i = 0; i < m; i++) {
            a[i] = sc.nextInt();
        }
        int n = s.length();
        char[] arr = s.toCharArray();
        for (int i = 0; i < m; i++) {
            if (a[i] == 1) {
                // Operation 1: swap first and last characters
                char temp = arr[0];
                arr[0] = arr[n - 1];
                arr[n - 1] = temp;
            } else if (a[i] == 2) {
                // Operation 2: swap first N/2 with last N/2
                int half = n / 2;
                char[] newArr = new char[n];
                for (int j = 0; j < half; j++) {
                    newArr[j] = arr[half + j];        // last half moves to front
                }
                for (int j = 0; j < half; j++) {
                    newArr[half + j] = arr[j];         // first half moves to back
                }
                arr = newArr;
            }
        }
        System.out.println(new String(arr));
    }
}

Knight Ranking Parade
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] a = new int[n];
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        // A sorted copy tells us the correct final order
        int[] sorted = a.clone();
        Arrays.sort(sorted);
        // Remember the correct index for each value
        HashMap<Integer, Integer> pos = new HashMap<>();
        for (int i = 0; i < n; i++) {
            pos.put(sorted[i], i);
        }
        int swaps = 0;
        for (int i = 0; i < n; i++) {
            // Keep swapping until position i holds the correct value
            while (a[i] != sorted[i]) {
                int correctIndex = pos.get(a[i]);   // where a[i] really belongs
                int temp = a[i];                    // swap a[i] with a[correctIndex]
                a[i] = a[correctIndex];
                a[correctIndex] = temp;
                swaps++;
            }
        }
        System.out.println(swaps);
    }
}

Minimum length
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.next();
        int n = s.length();
        int[] first = new int[26];
        int[] last = new int[26];
        Arrays.fill(first, -1);
        for (int i = 0; i < n; i++) {
            int c = s.charAt(i) - 'a';
            if (first[c] == -1) {
                first[c] = i;      // record first occurrence
            }
            last[c] = i;           // keep updating last occurrence
        }
        int ans = Integer.MAX_VALUE;
        for (int c = 0; c < 26; c++) {
            if (first[c] != -1) {
                int span = last[c] - first[c] + 1;
                ans = Math.min(ans, span);
            }
        }
        System.out.println(ans);
    }
}

Count subsets 
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] a = new int[n];
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }
        Arrays.sort(a);   // ascending order
        int ans = 1;
        for (int i = 1; i <= n; i++) {
            int value = a[i - 1];                    // i-th smallest (1-based)
            int need = (i + value - 1) / value;      // ceil(i / value)
            ans = Math.max(ans, need);
        }
        System.out.println(ans);
    }
}
Flip Div
import java.util.Scanner;
public class flipdiv {
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int k = sc.nextInt();
        for(int i=0;i<32;i++){
            int num=n^(1<<i);
            if(num%k==0){
                System.out.println(i+1);
                return;
            }
        }
        System.out.println(-1);
    }
    
}

