Frequency sync
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] a = new int[n];
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }
        String s = sc.next();   // lowercase string, no spaces
        // Frequency of each number in the array
        Map<Integer, Integer> numFreq = new HashMap<>();
        for (int x : a) {
            numFreq.put(x, numFreq.getOrDefault(x, 0) + 1);
        }
        // Frequency of each character in the string
        Map<Character, Integer> charFreq = new HashMap<>();
        for (char ch : s.toCharArray()) {
            charFreq.put(ch, charFreq.getOrDefault(ch, 0) + 1);
        }
        // Count matching (character, number) pairs
        int count = 0;
        for (int cf : charFreq.values()) {
            for (int nf : numFreq.values()) {
                if (cf == nf) {
                    count++;
                }
            }
        }
        System.out.println(count);
    }
}

Consonant vowel merge
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.next();

        StringBuilder consonants = new StringBuilder();
        StringBuilder vowels = new StringBuilder();
        for (char ch : s.toCharArray()) {
            if (isVowel(ch)) {
                vowels.append(ch);
            } else {
                consonants.append(ch);
            }
        }
        char[] result = new char[s.length()];
        int ci = 0;
        int vi = 0;
        for (int i = 0; i < s.length(); i++) {
            if (i % 2 == 0) {
                result[i] = consonants.charAt(ci++);
            } else {
                result[i] = vowels.charAt(vi++);
            }
        }
        System.out.println(new String(result));
    }
    static boolean isVowel(char ch) {
        return ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u';
    }
}
Count surrounded digits
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.next();
        int n = s.length();
        int count = 0;
        int i = 0;
        while (i < n) {
            if (Character.isDigit(s.charAt(i))) {
                int start = i;
                while (i < n && Character.isDigit(s.charAt(i))) {
                    i++;                       // extend over the whole digit run
                }
                int end = i - 1;               // run is s[start..end]
                boolean leftOk  = (start - 1 >= 0) && Character.isLetter(s.charAt(start - 1));
                boolean rightOk = (end + 1 < n)  && Character.isLetter(s.charAt(end + 1));

                if (leftOk && rightOk) {
                    count++;
                }
            } else {
                i++;
            }
        }
        System.out.println(count);
    }
}

Seat Allocation
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] a = new int[n];
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }
        boolean[] occupied = new boolean[n + 1];   // seats 1..n
        int[] result = new int[n];                 // result[i] = seat of student i
        for (int i = 0; i < n; i++) {
            int seat = a[i];
            while (occupied[seat]) {               // seat taken -> search circularly
                seat++;
                if (seat > n) {
                    seat = 1;                      // wrap around to seat 1
                }
            }
            occupied[seat] = true;
            result[i] = seat;
        }
        StringBuilder sb = new StringBuilder("{");
        for (int i = 0; i < n; i++) {
            sb.append(result[i]);
            if (i < n - 1) {
                sb.append(", ");
            }
        }
        sb.append("}");
        System.out.println(sb.toString());
    }
}

