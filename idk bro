import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int X = sc.nextInt();
        int Y = sc.nextInt();
        int Z = sc.nextInt();
        int fours = Z / 4;
        int rem = Z % 4;
        int cost = fours * Y;
        if (rem == 1 || rem == 2) cost += X;
        else if (rem == 3) cost += Math.min(Y, 2 * X);
        System.out.println(cost);
    }
}

2. Harmonic Pattern
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine().trim();
        int n = s.length(), maxLen = 0;
        for (int i = 0; i < n; i++) {
            int pos = i, blockLen = 2, total = 0;
            while (pos + blockLen <= n) {
                boolean match = true;
                for (int j = 0; j < blockLen; j++) {
                    if (s.charAt(pos + j) != (char) ('a' + j)) { match = false; break; }
                }
                if (!match) break;
                total += blockLen;
                pos += blockLen;
                blockLen++;
            }
            maxLen = Math.max(maxLen, total);
        }
        System.out.println(maxLen);
    }
}


3. River Current
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] c = new int[n];
        for (int i = 0; i < n; i++) c[i] = sc.nextInt();

        int[] left = new int[n];
        int last = 0;
        for (int i = 0; i < n; i++) { left[i] = last; if (c[i] != 0) last = c[i]; }

        int[] right = new int[n];
        last = 0;
        for (int i = n - 1; i >= 0; i--) { right[i] = last; if (c[i] != 0) last = c[i]; }

        int[] res = new int[n];
        for (int i = 0; i < n; i++) {
            if (c[i] != 0) res[i] = c[i];
            else {
                int l = left[i], r = right[i];
                if (l != 0 && r != 0) res[i] = (Math.abs(l) >= Math.abs(r)) ? l : r;
                else res[i] = (l != 0) ? l : r;
            }
        }

        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i++) { sb.append(res[i]); if (i < n - 1) sb.append(" "); }
        System.out.println(sb.toString());
    }
}



4. exponential series
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int a1 = sc.nextInt();
        int r = sc.nextInt();
        int z = sc.nextInt();
        List<Integer> series = new ArrayList<>();
        long term = a1;
        while (term <= z) {
            series.add((int) term);
            term = term * r;
        }
        StringBuilder sb = new StringBuilder("{");
        for (int i = 0; i < series.size(); i++) {
            sb.append(series.get(i));
            if (i < series.size() - 1) sb.append(", ");
        }
        sb.append("}");
        System.out.println(sb.toString());
    }
}

